{
  "name": "openrouter-code-translator",
  "displayName": "OpenRouter Code Translator",
  "description": "Convert files or full projects across 14 languages using a multi-model OpenRouter ensemble",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeTranslator.convertProject",
        "title": "Code Translator: Convert Project"
      },
      {
        "command": "codeTranslator.pickLanguageAndConvert",
        "title": "Code Translator: Pick Language and Convert"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-translator-sidebar",
          "icon": "media/icon.svg",
          "title": "Code Translator"
        }
      ]
    },
    "views": {
      "code-translator-sidebar": [
        {
          "id": "code-translator-view",
          "name": "Code Translator"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.12.22",
    "dotenv": "^17.4.2"
  }
}
