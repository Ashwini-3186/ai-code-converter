{
  "name": "vini-openrouter-code-translator",
  "displayName": "Vini OpenRouter Code Translator",
  "description": "AI code converter for file and project translation across multiple languages using OpenRouter ensemble models",
  "version": "0.0.1",
  "publisher": "ashwini-codes",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "code-converter",
    "openrouter",
    "translation",
    "vscode-extension",
    "multi-language",
    "developer-tools"
  ],
  "homepage": "https://github.com/Ashwini-3186/ai-code-converter",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ashwini-3186/ai-code-converter.git"
  },
  "license": "MIT",
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeTranslator.convertProject",
        "title": "Code Translator: Convert Project"
      },
      {
        "command": "codeTranslator.pickLanguageAndConvert",
        "title": "Code Translator: Pick Language and Convert"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-translator-sidebar",
          "title": "Code Translator",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "code-translator-sidebar": [
        {
          "id": "code-translator-view",
          "name": "Code Translator"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "echo no build needed"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
